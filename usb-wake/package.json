{
  "name": "personal-usb-wake",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && wrangler dev --config cloud/wrangler.jsonc --ip 127.0.0.1 --port 16030",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test test/*.test.mjs",
    "build": "node scripts/build.mjs && wrangler deploy --config cloud/wrangler.jsonc --dry-run --outdir dist",
    "deploy": "node scripts/build.mjs && wrangler deploy --config cloud/wrangler.jsonc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "^3.0.0",
    "wrangler": "4.151.0"
  }
}
