{
  "$schema": "../schema/app.schema.json",
  "order": 20,
  "name": "Simple File Server",
  "description": "Browse, preview, upload and manage files on the host.",
  "icon": "📁",
  "enabled": true,
  "root": "${paths.project}/SimpleFileServer",
  "basePath": "/simple-file-server",
  "ports": {
    "frontend": 5120,
    "backend": 5121
  },
  "env": {
    "SFS_FRONTEND_PORT": "${ports.frontend}",
    "SFS_BACKEND_PORT": "${ports.backend}"
  },
  "routes": {
    "snippet": "${root}/Caddyfile.snippet",
    "env": "${root}/caddy-env.ps1"
  },
  "launch": {
    "file": "pwsh",
    "args": [
      "-NoProfile",
      "-File",
      "${root}/start.ps1",
      "-NoCaddy"
    ]
  }
}
