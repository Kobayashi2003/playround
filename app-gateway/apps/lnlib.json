{
  "$schema": "../schema/app.schema.json",
  "order": 50,
  "name": "蔵書棚",
  "description": "Light novel, manga and artbook shelf, with a reader in the browser.",
  "icon": "📖",
  "enabled": true,
  "root": "${paths.playround}/lnlib",
  "basePath": "/lnlib",
  "ports": {
    "http": 16020
  },
  "routes": {
    "proxy": [
      {
        "upstream": "127.0.0.1:${ports.http}"
      }
    ]
  },
  "launch": {
    "file": "python",
    "args": [
      "-m",
      "lnlib",
      "serve",
      "--host",
      "127.0.0.1",
      "--port",
      "${ports.http}",
      "--base-path",
      "${basePath}",
      "--no-browser"
    ]
  }
}
