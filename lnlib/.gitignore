# Local state: the index and any backups. All of it is rebuilt by `scan` except
# reading progress, which is personal.
data/
# The cover cache, rebuilt by `covers`
cache/

# This machine's library folders. config.example.json shows the shape;
# `uv run main.py config --add-root …` writes the real one.
config.json
*.tmp

# Logs, editors, operating systems
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
